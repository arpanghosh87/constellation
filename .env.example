# Required: your Claude API key (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=

# Optional: require an access code to use the hosted app (leave empty locally)
ACCESS_CODE=
# Optional: key for signing the access cookie (defaults to ANTHROPIC_API_KEY)
ACCESS_SECRET=

# Optional: shared rate limiting on Vercel (Upstash Redis integration sets these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
